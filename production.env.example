# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:supersecurepassword@postgres:5432/aether_mart_db?schema=public"

# ─── CACHE & BROKER CONFIGURATION ────────────────────────────────────────────
REDIS_URL="redis://redis:6379"

# ─── APPLICATION HOSTING ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
VITE_API_BASE_URL="http://localhost/api"

# ─── SECURITY SECRETS ────────────────────────────────────────────────────────
# Generate strong cryptographic keys in production
JWT_SECRET="use-a-strong-random-hex-key"
REFRESH_TOKEN_SECRET="use-a-different-strong-random-hex-key"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"
COOKIE_SECRET="cookie-signing-passphrase"
